# Cloudinary Configuration
# Obtén estas credenciales en: https://cloudinary.com/console

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Instrucciones:
# 1. Crea una cuenta gratuita en https://cloudinary.com
# 2. Ve a Dashboard > Settings > Access Keys
# 3. Copia tus credenciales aquí
# 4. Agrega estas variables a tu archivo .env.local
